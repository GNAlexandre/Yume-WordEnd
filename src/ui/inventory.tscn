[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/inventory.gd" id="1_inventory"]
[ext_resource type="Theme" path="res://src/ui/wordend_theme.tres" id="2_theme"]

[node name="Inventory" type="Control"]
process_mode = 3
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_inventory")

[node name="Dim" type="Panel" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"Dim"

[node name="Panel" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -320.0
offset_top = -215.0
offset_right = 320.0
offset_bottom = 215.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 0
theme_override_constants/margin_top = 0
theme_override_constants/margin_right = 0
theme_override_constants/margin_bottom = 0

[node name="Layout" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Header" type="HBoxContainer" parent="Panel/Margin/Layout"]
layout_mode = 2

[node name="Title" type="Label" parent="Panel/Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeaderLabel"
theme_override_font_sizes/font_size = 36
text = "Inventaire"

[node name="CloseButton" type="Button" parent="Panel/Margin/Layout/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 21
text = "Fermer"

[node name="Body" type="HBoxContainer" parent="Panel/Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Grid" type="GridContainer" parent="Panel/Margin/Layout/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 0
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 4

[node name="Details" type="VBoxContainer" parent="Panel/Margin/Layout/Body"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
theme_override_constants/separation = 6

[node name="DetailIcon" type="TextureRect" parent="Panel/Margin/Layout/Body/Details"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 96)
layout_mode = 2
size_flags_horizontal = 4
expand_mode = 1
stretch_mode = 5

[node name="DetailName" type="Label" parent="Panel/Margin/Layout/Body/Details"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
theme_type_variation = &"HeaderLabel"
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1
autowrap_mode = 3

[node name="DetailQuantity" type="Label" parent="Panel/Margin/Layout/Body/Details"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
horizontal_alignment = 1

[node name="DetailDescription" type="Label" parent="Panel/Margin/Layout/Body/Details"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 18
autowrap_mode = 3

[node name="Hint" type="Label" parent="Panel/Margin/Layout"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 15
text = "Flèches ou survol : choisir    I / Y, Échap / B : fermer"
horizontal_alignment = 1
